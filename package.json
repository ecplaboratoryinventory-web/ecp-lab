{
  "name": "ecp-lab",
  "version": "1.0.0",
  "private": true,
  "description": "ECP Laboratory Inventory Management System",
  "workspaces": [
    "web",
    "mobile",
    "scripts"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "build:web": "npm run build -w web",
    "build:mobile": "npm run build -w mobile",
    "lint": "npm run lint -w web",
    "migrate": "node scripts/migrate-data.mjs",
    "seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.0",
    "mysql2": "^3.23.1",
    "pdf-parse": "^2.4.5"
  }
}
